#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors/mouse_keys.dtsi>

#define QWERTY 0
#define SYMBOL 1
#define ACTION 2
#define KEYBOARD 3
#define SYMBOL_OLD 4
#define ACTION_OLD 5

&caps_word {
    continue-list = <UNDERSCORE MINUS>;
};

/ {
    tpad0_mmv_ibl {
        compatible = "zmk,input-behavior-listener";
        device = <&tpad0>;
        layers = <QWERTY>;
        y-invert;
    };
    tpad0_msl_ibl {
        compatible = "zmk,input-behavior-listener";
        device = <&tpad0>;
        layers = <SYMBOL ACTION>;
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_MISC>;
        y-input-code = <INPUT_REL_WHEEL>;
        bindings = <&ib_wheel_scaler 1 8>, <&ib_misc_scaler 0 0>;
    };
    ib_wheel_scaler: ib_wheel_scaler {
        compatible = "zmk,input-behavior-scaler";
        #binding-cells = <2>;
        evt-type = <INPUT_EV_REL>;
        input-code = <INPUT_REL_WHEEL>;
    };
    ib_misc_scaler: ib_misc_scaler {
            compatible = "zmk,input-behavior-scaler";
            #binding-cells = <2>;
            evt-type = <INPUT_EV_REL>;
            input-code = <INPUT_REL_MISC>;
    };
    ib_x_scaler: ib_x_scaler {
        compatible = "zmk,input-behavior-scaler";
        #binding-cells = <2>;
        evt-type = <INPUT_EV_REL>;
        input-code = <INPUT_REL_X>;
    };
    ib_y_scaler: ib_y_scaler {
        compatible = "zmk,input-behavior-scaler";
        #binding-cells = <2>;
        evt-type = <INPUT_EV_REL>;
        input-code = <INPUT_REL_Y>;
    };
    behaviors {
        hml: homerow_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <250>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <150>;
            hold-while-undecided;
            hold-trigger-key-positions = <2 3 10 11 12 13 14 15 22 23 24 25 26 27 34 35 36 37 38 39 46 47 48 49 50 51>;
            hold-trigger-on-release;
        };
        hsh: homerow_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <250>;
        };
        hmr: homerow_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <250>;
            quick-tap-ms = <250>;
            require-prior-idle-ms = <250>;
            hold-while-undecided;
            hold-trigger-key-positions = <0 1 4 5 6 7 8 9 16 17 18 19 20 21 28 29 30 31 32 33 40 41 42 43 44 45>;
            hold-trigger-on-release;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        qwerty_layer {
            display-name = "QWERTY";
/*-----------------------QWERTY-----------------------*\
  Q    W    E    R    T          Y    U    I    O    P
  A/⇧  S/⌃  D/⌥  F/⌘  G          H    J/⌘  K/⌥  L/⌃  ;
  Z    X    X    C    V          N    M    ,    .    /
     rclk  lclk                          lclk  rclk
                       ⌫        ↹
                       ␣        ⏎
                      SYM      SYM
/*------------------------SYMBOL----------------------*\
 esc   7    8    9                         ↑         `
  0    4    5    6    (          )    ←    ↓    →    '
       1    2    3    [          ]    -    =    _    \
     rclk  lclk                          lclk  rclk


                       ⌨️        ⌨️
/*----------------------KEYBOARD-----------------------*\
 ❌                                                 ❌
 🛜0  🛜1  🛜2  🛜3  🛜4         🛜4  🛜3  🛜2  🛜1  🛜0
 ❌0  ❌1  ❌2  ❌3  ❌4         ❌4  ❌3  ❌2  ❌1  ❌0
/*-----------------------------------------------------*/
            bindings = <
&kp Q         &kp W         &kp E         &kp R         &kp T                        &kp Y         &kp U          &kp I          &kp O           &kp P
&hsh LSHFT A  &hml LCTRL S  &hml LALT D   &hml LGUI F   &kp G                        &kp H         &hmr RGUI J    &hmr RALT K    &hmr RCTRL L    &hsh RSHFT SEMI
&kp Z         &kp X         &kp C         &kp V         &kp B                        &kp N         &kp M          &kp COMMA      &kp DOT         &kp FSLH
              &mkp RCLK     &mkp LCLK                                                                             &mkp LCLK      &mkp RCLK
                                                             &kp BSPC           &kp TAB
                                                             &kp SPACE          &kp RET
                                                             &mo SYMBOL         &mo SYMBOL
            >;
        };

        symbol_layer {
            display-name = "SYMBOL";
            bindings = <
&kp ESC       &kp N7        &kp N8        &kp N9        &none                        &none         &none          &kp UP         &none            &kp GRAVE
&hsh LSHFT N0 &hml LCTRL N4 &hml LALT N5  &hml LGUI N6  &kp LPAR                     &kp RPAR      &kp LEFT       &kp DOWN       &kp RIGHT        &hsh RSHFT SQT
&none         &kp N1        &kp N2        &kp N3        &kp LBKT                     &kp RBKT      &kp MINUS      &kp EQUAL      &kp UNDER        &kp BSLH
                            &mkp LCLK     &mkp RCLK                                                               &mkp LCLK      &mkp RCLK
                                                                 &trans             &trans
                                                                 &trans             &trans
                                                                 &mo KEYBOARD       &mo KEYBOARD
            >;
        };

        keyboard_layer {
            display-name = "KEYBOARD";
            bindings = <
&bt BT_CLR    &none         &none         &none         &none                        &none         &none          &none          &none            &bt BT_CLR
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                 &bt BT_SEL 4  &bt BT_SEL 3   &bt BT_SEL 2   &bt BT_SEL 1     &bt BT_SEL 0
&bt BT_DISC 0 &bt BT_DISC 1 &bt BT_DISC 2 &bt BT_DISC 3 &bt BT_DISC 4                &bt BT_DISC 4 &bt BT_DISC 3  &bt BT_DISC 2  &bt BT_DISC 1    &bt BT_DISC 0
              &none         &none                                                                                 &none          &none
                                                                 &none             &none
                                                                 &none             &none
                                                                 &none             &none
            >;
        };
    };
};
