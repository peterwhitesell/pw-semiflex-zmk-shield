#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors/mouse_keys.dtsi>

#define QWERTY 0
#define SYMBOL 1
#define ACTION 0

&caps_word {
    continue-list = <UNDERSCORE MINUS>;
};

/ {
    behaviors {
        td_lshft: tap_dance_shift {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LSHFT>, <&caps_word>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        qwerty_layer {
            display-name = "QWERTY";
            bindings = <
                          &kp BSPC     &kp DEL                                                                          &kp BSPC     &kp DEL
&bt BT_CLR   &kp Q        &kp W        &kp E        &kp R        &kp T                        &kp Y        &kp U        &kp I        &kp O        &kp P        &kp SQT
&td_lshft    &kp A        &kp S        &kp D        &kp F        &kp G                        &kp H        &kp J        &kp K        &kp L        &kp SEMI     &kp ENTER
&kp LCTL     &kp Z        &kp X        &kp C        &kp V        &kp B                        &kp N        &kp M        &kp COMMA    &kp DOT      &kp FSLH     &kp RSHFT
                          &kp RCLK     &kp LCLK                                                                         &kp LCLK     &kp RCLK
                                &mo SYMBOL   &kp LGUI     &mo ACTION                     &mo SYMBOL   &kp RGUI     &mo ACTION
                                &kp trans    &kp trans    &kp trans                      &kp trans    &kp trans    &kp trans
            >;
        };

        symbol_layer {
            display-name = "SYMBOL";
            bindings = <
                          &kp trans    &kp trans                                                                        &kp trans    &kp trans
&kp trans    &kp trans    &kp N7       &kp N8       &kp N9       &kp trans                    &kp trans    &kp trans    &kp UP       &kp trans    &kp trans    &kp GRAVE
&kp trans    &kp trans    &kp N4       &kp N5       &kp N6       &kp LPAR                     &kp RPAR     &kp LEFT     &kp DOWN     &kp trans    &kp RIGHT    &kp trans
&kp trans    &kp N0       &kp N1       &kp N2       &kp N3       &kp LBKT                     &kp RBKT     &kp MINUS    &kp EQUAL    &kp UNDER    &kp PIPE     &kp trans
                          &kp trans    &kp trans                                                                        &kp trans    &kp trans
                                &kp trans    &kp trans    &kp trans                      &kp trans    &kp trans    &kp trans
                                &kp trans    &kp trans    &kp trans                      &kp trans    &kp trans    &kp trans
            >;
        };

        action_layer {
            display-name = "ACTION";
            bindings = <
                          &kp trans    &kp trans                                                                        &kp trans    &kp trans
&kp trans    &kp trans    &kp trans    &kp trans    &kp trans    &kp trans                    &kp trans    &kp trans    &kp trans    &kp trans    &kp trans    &kp trans
&kp trans    &kp trans    &kp trans    &kp trans    &kp trans    &kp trans                    &kp trans    &kp trans    &kp trans    &kp trans    &kp trans    &kp trans
&kp trans    &kp trans    &kp trans    &kp trans    &kp trans    &kp trans                    &kp trans    &kp trans    &kp trans    &kp trans    &kp trans    &kp trans
                          &kp trans    &kp trans                                                                        &kp trans    &kp trans
                                &kp trans    &kp trans    &kp trans                      &kp trans    &kp trans    &kp trans
                                &kp trans    &kp trans    &kp trans                      &kp trans    &kp trans    &kp trans
            >;
        };
    };

    /* assign `input-listener` to all pointing devices */
    /* &pd0 on central, &pd1 on peripheral */
    trackball_central_listener {
        compatible = "zmk,input-listener";
        device = <&pd0>;
    };
    trackball_peripheral_listener {
        compatible = "zmk,input-listener";
        device = <&pd1>;
    };
};
